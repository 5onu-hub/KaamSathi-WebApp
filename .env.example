# KaamSathi Environment Variables Configuration (.env.example)

# Application Environment
NODE_ENV=production
PORT=3000

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/kaamsathi?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# AI & External APIs
GEMINI_API_KEY=your_google_gemini_api_key_here

# Payment Gateway (Razorpay / Stripe Demo)
RAZORPAY_KEY_ID=rzp_live_demo_key_id
RAZORPAY_KEY_SECRET=rzp_live_demo_secret

# Monitoring & Logging
SENTRY_DSN=https://exampleKey@o0.ingest.sentry.io/0
LOG_LEVEL=info
